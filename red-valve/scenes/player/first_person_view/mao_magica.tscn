[node name="MaoMagica" type="Node3D"]
script = ExtResource("1_sway")

; A mao magica nasce 15 cm ACIMA do que a pose do Blender diz.
; O nó antigo tinha uma base girada e uma origem propria que, somadas,
; punham a mao 15 cm mais alta do que ela cai agora — e a 26 cm do olho
; esses 15 cm sao quase uma tela inteira: o punho ficava embaixo do quadro.
; Este numero e a origem do `hand_magic` sao a MESMA coisa que o
; `hand_magic_3d_pos_original` do player.gd, que e o alvo pra onde os tweens
; de soco e recarga trazem a mao de volta.
[node name="hand_magic" parent="." instance=ExtResource("2_rig")]
transform = Transform3D(0.17, 0, 0, 0, 0.17, 0, 0, 0, 0.17, -0.03, 0.15, 0)

