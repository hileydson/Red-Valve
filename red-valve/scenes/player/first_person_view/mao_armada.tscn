[node name="MaoArmada" type="Node3D" unique_id=792329764]
editor_description = "Primeira pessoa: PreviaDaTela e o olho do jogo. Selecione rig para escolher arma, acao e instante; edite os clipes no AnimationPlayer. F6: F1 pistola, F2 shotgun, F3 cogblade, R recarga, clique ataca, direito defende. Armas contem os modelos usados no jogo; Malhas e somente o rig importado."
script = ExtResource("1_sway")

